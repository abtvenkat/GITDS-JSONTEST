                              "val": "YYYYMMDD"
                            }
                          ]
                        }
                      ]
                    },
                    ">",
                    {
                      "val": 10
                    },
                    "then",
                    {
                      "val": 1
                    },
                    "else",
                    {
                      "val": 0
                    },
                    "end"
                  ]
                },
                {
