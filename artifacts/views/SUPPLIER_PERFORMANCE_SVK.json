{
  "definitions": {
    "SUPPLIER_PERFORMANCE_SVK": {
      "kind": "entity",
      "@EndUserText.label": "Terminal L3 Fact View combining purchase order items, deliveries, supplier details, and material prices with KPI formulas.",
      "elements": {
        "PurchaseOrder": {
          "type": "cds.String",
          "@EndUserText.label": "Purchase order number",
          "length": 10
        },
        "PurchaseOrderItem": {
          "type": "cds.String",
          "@EndUserText.label": "Item number of purchase order",
          "length": 5
        },
        "Supplier": {
          "type": "cds.String",
          "@EndUserText.label": "Account number of supplier",
          "length": 10,
          "key": true
        },
        "SupplierName": {
          "type": "cds.String",
          "@EndUserText.label": "Name of supplier",
          "length": 80
        },
        "Material": {
          "type": "cds.String",
          "@EndUserText.label": "Material number",
          "length": 40,
          "key": true
        },
        "Plant": {
          "type": "cds.String",
          "@EndUserText.label": "Plant",
          "length": 4
        },
        "OrderQuantity": {
          "type": "cds.Decimal",
          "@EndUserText.label": "Purchase order quantity",
          "precision": 13,
          "scale": 3,
          "@AnalyticsDetails.measureType": {
            "#": "BASE"
          },
          "@Aggregation.default": {
            "#": "SUM"
          }
        },
        "ActualDeliveryQuantity": {
          "type": "cds.Decimal",
          "@EndUserText.label": "Actual quantity delivered (in sales units)",
          "precision": 13,
          "scale": 3,
          "@AnalyticsDetails.measureType": {
            "#": "BASE"
          },
          "@Aggregation.default": {
            "#": "SUM"
          }
        },
        "NetPriceAmount": {
          "type": "cds.Decimal",
          "@EndUserText.label": "Net price in purchasing document (in document currency)",
          "precision": 31,
          "scale": 6,
          "@AnalyticsDetails.measureType": {
            "#": "BASE"
          },
          "@Aggregation.default": {
            "#": "SUM"
          }
        },
        "StandardPrice": {
          "type": "cds.Decimal",
          "@EndUserText.label": "Standard price",
          "precision": 31,
          "scale": 6,
          "@AnalyticsDetails.measureType": {
            "#": "BASE"
          },
          "@Aggregation.default": {
            "#": "SUM"
          }
        },
        "DeliveryDate": {
          "type": "cds.String",
          "@EndUserText.label": "Delivery date",
          "length": 8
        },
        "ActualGoodsMovementDate": {
          "type": "cds.String",
          "@EndUserText.label": "Actual goods movement date",
          "length": 8
        },
        "IsOnTimeDelivery": {
          "type": "cds.Integer",
          "@EndUserText.label": "On-Time Delivery Flag",
          "@DataWarehouse.native.dataType": "INTEGER",
          "@AnalyticsDetails.measureType": {
            "#": "BASE"
          },
          "@Aggregation.default": {
            "#": "AVG"
          }
        },
        "IsFullyFulfilled": {
          "type": "cds.Integer",
          "@EndUserText.label": "Full Fulfillment Flag",
          "@DataWarehouse.native.dataType": "INTEGER",
          "@AnalyticsDetails.measureType": {
            "#": "BASE"
          },
          "@Aggregation.default": {
            "#": "AVG"
          }
        },
        "PriceVariance": {
          "type": "cds.Decimal",
          "@EndUserText.label": "Price Variance",
          "@DataWarehouse.native.dataType": "DECIMAL",
          "precision": 31,
          "scale": 6,
          "@AnalyticsDetails.measureType": {
            "#": "BASE"
          },
          "@Aggregation.default": {
            "#": "AVG"
          }
        }
      },
      "query": {
        "SELECT": {
          "from": {
            "SELECT": {
              "from": {
                "SELECT": {
                  "from": {
                    "join": "LEFT",
                    "args": [
                      {
                        "join": "LEFT",
                        "args": [
                          {
                            "join": "LEFT",
                            "args": [
                              {
                                "join": "LEFT",
                                "args": [
                                  {
                                    "ref": [
                                      "WRAP_C_PURCHASEORDERITEMDEX"
                                    ],
                                    "as": "WRAP_C_PURCHASEORDERITEMDEX"
                                  },
                                  {
                                    "ref": [
                                      "WRAP_I_DELIVERYDOCUMENTITEM"
                                    ],
                                    "as": "WRAP_I_DELIVERYDOCUMENTITEM"
                                  }
                                ],
                                "on": [
                                  {
                                    "ref": [
                                      "WRAP_C_PURCHASEORDERITEMDEX",
                                      "PurchaseOrder"
                                    ]
                                  },
                                  "=",
                                  {
                                    "ref": [
                                      "WRAP_I_DELIVERYDOCUMENTITEM",
                                      "PurchaseOrder"
                                    ]
                                  }
                                ]
                              },
                              {
                                "ref": [
                                  "WRAP_I_DELIVERYDOCUMENT"
                                ],
                                "as": "WRAP_I_DELIVERYDOCUMENT"
                              }
                            ],
                            "on": [
                              {
                                "ref": [
                                  "WRAP_I_DELIVERYDOCUMENTITEM",
                                  "DeliveryDocument"
                                ]
                              },
                              "=",
                              {
                                "ref": [
                                  "WRAP_I_DELIVERYDOCUMENT",
                                  "DeliveryDocument"
                                ]
                              }
                            ]
                          },
                          {
                            "ref": [
                              "WRAP_I_SUPPLIER"
                            ],
                            "as": "WRAP_I_SUPPLIER"
                          }
                        ],
                        "on": [
                          {
                            "ref": [
                              "WRAP_C_PURCHASEORDERITEMDEX",
                              "Supplier"
                            ]
                          },
                          "=",
                          {
                            "ref": [
                              "WRAP_I_SUPPLIER",
                              "Supplier"
                            ]
                          }
                        ]
                      },
                      {
                        "ref": [
                          "WRAP_ZCDS_I_MAT_VAL"
                        ],
                        "as": "WRAP_ZCDS_I_MAT_VAL"
                      }
                    ],
                    "on": [
                      {
                        "ref": [
                          "WRAP_C_PURCHASEORDERITEMDEX",
                          "Material"
                        ]
                      },
                      "=",
                      {
                        "ref": [
                          "WRAP_ZCDS_I_MAT_VAL",
                          "Material"
                        ]
                      }
                    ]
                  },
                  "columns": [
                    {
                      "ref": [
                        "WRAP_C_PURCHASEORDERITEMDEX",
                        "PurchaseOrder"
                      ]
                    },
                    {
                      "ref": [
                        "WRAP_C_PURCHASEORDERITEMDEX",
                        "PurchaseOrderItem"
                      ]
                    },
                    {
                      "ref": [
                        "WRAP_C_PURCHASEORDERITEMDEX",
                        "Supplier"
                      ],
                      "key": true
                    },
                    {
                      "ref": [
                        "WRAP_I_SUPPLIER",
                        "SupplierName"
                      ]
                    },
                    {
                      "ref": [
                        "WRAP_C_PURCHASEORDERITEMDEX",
                        "Material"
                      ],
                      "key": true
                    },
                    {
                      "ref": [
                        "WRAP_C_PURCHASEORDERITEMDEX",
                        "Plant"
                      ]
                    },
                    {
                      "ref": [
                        "WRAP_C_PURCHASEORDERITEMDEX",
                        "OrderQuantity"
                      ]
                    },
                    {
                      "ref": [
                        "WRAP_I_DELIVERYDOCUMENTITEM",
                        "ActualDeliveryQuantity"
                      ]
                    },
                    {
                      "ref": [
                        "WRAP_C_PURCHASEORDERITEMDEX",
                        "NetPriceAmount"
                      ]
                    },
                    {
                      "ref": [
                        "WRAP_ZCDS_I_MAT_VAL",
                        "StandardPrice"
                      ]
                    },
                    {
                      "ref": [
                        "WRAP_I_DELIVERYDOCUMENT",
                        "DeliveryDate"
                      ]
                    },
                    {
                      "ref": [
                        "WRAP_I_DELIVERYDOCUMENT",
                        "ActualGoodsMovementDate"
                      ]
                    }
                  ]
                },
                "as": "Source Columns 1"
              },
              "columns": [
                {
                  "ref": [
                    "Source Columns 1",
                    "PurchaseOrder"
                  ]
                },
                {
                  "ref": [
                    "Source Columns 1",
                    "PurchaseOrderItem"
                  ]
                },
                {
                  "ref": [
                    "Source Columns 1",
                    "Supplier"
                  ],
                  "key": true
                },
                {
                  "ref": [
                    "Source Columns 1",
                    "SupplierName"
                  ]
                },
                {
                  "ref": [
                    "Source Columns 1",
                    "Material"
                  ],
                  "key": true
                },
                {
                  "ref": [
                    "Source Columns 1",
                    "Plant"
                  ]
                },
                {
                  "ref": [
                    "Source Columns 1",
                    "OrderQuantity"
                  ]
                },
                {
                  "ref": [
                    "Source Columns 1",
                    "ActualDeliveryQuantity"
                  ]
                },
                {
                  "ref": [
                    "Source Columns 1",
                    "NetPriceAmount"
                  ]
                },
                {
                  "ref": [
                    "Source Columns 1",
                    "StandardPrice"
                  ]
                },
                {
                  "ref": [
                    "Source Columns 1",
                    "DeliveryDate"
                  ]
                },
                {
                  "ref": [
                    "Source Columns 1",
                    "ActualGoodsMovementDate"
                  ]
                },
                {
                  "as": "IsOnTimeDelivery",
                  "xpr": [
                    "case",
                    "when",
                    {
                      "ref": [
                        "Source Columns 1",
                        "ActualGoodsMovementDate"
                      ]
                    },
                    "<=",
                    {
                      "ref": [
                        "Source Columns 1",
                        "DeliveryDate"
                      ]
                    },
                    "then",
                    {
                      "val": 1
                    },
                    "else",
                    {
                      "val": 0
                    },
                    "end"
                  ]
                },
                {
                  "as": "IsFullyFulfilled",
                  "xpr": [
                    "case",
                    "when",
                    {
                      "ref": [
                        "Source Columns 1",
                        "ActualDeliveryQuantity"
                      ]
                    },
                    ">=",
                    {
                      "ref": [
                        "Source Columns 1",
                        "OrderQuantity"
                      ]
                    },
                    "then",
                    {
                      "val": 1
                    },
                    "else",
                    {
                      "val": 0
                    },
                    "end"
                  ]
                },
                {
                  "as": "PriceVariance",
                  "xpr": [
                    {
                      "xpr": [
                        {
                          "ref": [
                            "Source Columns 1",
                            "NetPriceAmount"
                          ]
                        },
                        "-",
                        {
                          "ref": [
                            "Source Columns 1",
                            "StandardPrice"
                          ]
                        }
                      ],
                      "cast": {
                        "type": "cds.Decimal",
                        "precision": 31,
                        "scale": 6
                      }
                    }
                  ]
                }
              ]
            },
            "as": "Calculated Columns 1"
          },
          "columns": [
            {
              "ref": [
                "Calculated Columns 1",
                "PurchaseOrder"
              ]
            },
            {
              "ref": [
                "Calculated Columns 1",
                "PurchaseOrderItem"
              ]
            },
            {
              "ref": [
                "Calculated Columns 1",
                "Supplier"
              ],
              "key": true
            },
            {
              "ref": [
                "Calculated Columns 1",
                "SupplierName"
              ]
            },
            {
              "ref": [
                "Calculated Columns 1",
                "Material"
              ],
              "key": true
            },
            {
              "ref": [
                "Calculated Columns 1",
                "Plant"
              ]
            },
            {
              "ref": [
                "Calculated Columns 1",
                "OrderQuantity"
              ]
            },
            {
              "ref": [
                "Calculated Columns 1",
                "ActualDeliveryQuantity"
              ]
            },
            {
              "ref": [
                "Calculated Columns 1",
                "NetPriceAmount"
              ]
            },
            {
              "ref": [
                "Calculated Columns 1",
                "StandardPrice"
              ]
            },
            {
              "ref": [
                "Calculated Columns 1",
                "DeliveryDate"
              ]
            },
            {
              "ref": [
                "Calculated Columns 1",
                "ActualGoodsMovementDate"
              ]
            },
            {
              "ref": [
                "Calculated Columns 1",
                "IsOnTimeDelivery"
              ]
            },
            {
              "ref": [
                "Calculated Columns 1",
                "IsFullyFulfilled"
              ]
            },
            {
              "ref": [
                "Calculated Columns 1",
                "PriceVariance"
              ]
            }
          ],
          "where": [
            {
              "ref": [
                "Calculated Columns 1",
                "OrderQuantity"
              ]
            },
            ">",
            {
              "val": "50"
            }
          ]
        }
      },
      "@ObjectModel.modelingPattern": {
        "#": "ANALYTICAL_FACT"
      },
      "@ObjectModel.supportedCapabilities": [
        {
          "#": "DATA_STRUCTURE"
        }
      ],
      "@DataWarehouse.consumption.external": false
    }
  }
}